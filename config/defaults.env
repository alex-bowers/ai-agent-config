# Optional configuration defaults. Values in .agent-config.local.env override these.
# This file is sourced by POSIX sh. Keep values shell-safe and do not add secrets.

CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
COPILOT_HOME="${COPILOT_HOME:-$HOME/.agents}"
AGENT_CONFIG_CACHE_DIR="${AGENT_CONFIG_CACHE_DIR:-$AGENT_CONFIG_HOME/.agent-config-cache}"
SKILL_SOURCES_FILE="${SKILL_SOURCES_FILE:-$AGENT_CONFIG_HOME/config/skill-sources.txt}"

